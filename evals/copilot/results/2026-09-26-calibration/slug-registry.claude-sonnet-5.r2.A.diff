--- a/src/registry.ts
+++ b/src/registry.ts
@@ -1,3 +1,28 @@
+import { slugify, truncateSlug, type SlugOptions } from "./slug.ts";
+
 export function articlePath(slug: string): string {
   return `/articles/${slug}`;
 }
+
+/**
+ * Builds a slug for `title` that does not collide with any slug in `existing`.
+ * Collisions are resolved by appending `-2`, `-3`, etc., truncating the base
+ * slug as needed so the final result never exceeds the configured maxLength.
+ */
+export function uniqueSlug(
+  title: string,
+  existing: Iterable<string>,
+  options: SlugOptions = {},
+): string {
+  const maxLength = options.maxLength ?? 60;
+  const used = new Set(existing);
+  const base = slugify(title, options);
+  if (!used.has(base)) return base;
+
+  for (let n = 2; ; n++) {
+    const suffix = `-${n}`;
+    const trimmedBase = truncateSlug(base, Math.max(1, maxLength - suffix.length));
+    const candidate = `${trimmedBase}${suffix}`;
+    if (!used.has(candidate)) return candidate;
+  }
+}

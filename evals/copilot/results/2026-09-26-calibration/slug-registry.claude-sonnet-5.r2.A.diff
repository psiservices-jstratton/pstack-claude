@@ -20,3 +20,20 @@ test("creates article records with paths", () => {
   assert.equal(article.slug, "roadmap-q4-launch");
   assert.equal(articlePath(article.slug), "/articles/roadmap-q4-launch");
 });
+
+test("uniqueSlug returns base slug when unused", () => {
+  assert.equal(uniqueSlug("Hello World", []), "hello-world");
+});
+
+test("uniqueSlug appends incrementing suffixes on collision", () => {
+  const existing = new Set(["hello-world", "hello-world-2"]);
+  assert.equal(uniqueSlug("Hello World", existing), "hello-world-3");
+});
+
+test("uniqueSlug keeps result within maxLength when adding a suffix", () => {
+  const base = slugify("alpha beta gamma delta epsilon", { maxLength: 18 });
+  const existing = new Set([base]);
+  const result = uniqueSlug("alpha beta gamma delta epsilon", existing, { maxLength: 18 });
+  assert.ok(result.length <= 18);
+  assert.equal(result, "alpha-beta-gamma-2");
+});

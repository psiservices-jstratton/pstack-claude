+type Transition = {
+  /** Statuses from which this transition is allowed to run. */
+  from: InvoiceStatus[];
+  /** Status a successful transition moves the invoice into. */
+  to: InvoiceStatus;
+  /** Statuses that already satisfy the transition, so it becomes a no-op. */
+  noop: InvoiceStatus[];
+  /** Error raised when the invoice is in a status outside `from`/`noop`. */
+  error: string;
+  /** Timestamp field stamped on the invoice when the transition applies. */
+  at: keyof Pick<Invoice, "sentAt" | "paidAt" | "voidedAt" | "refundedAt">;
+};
+
+function applyTransition(invoice: Invoice, at: string, transition: Transition): Invoice {
+  if (transition.noop.includes(invoice.status)) return invoice;
+  if (!transition.from.includes(invoice.status)) throw new Error(transition.error);
+  return { ...invoice, status: transition.to, [transition.at]: at };
+}

-  refunded: boolean;
+  status: InvoiceStatus;
   sentAt?: string;
   paidAt?: string;
   voidedAt?: string;
   refundedAt?: string;
 };
 
+type InvoiceEvent = "send" | "pay" | "void" | "refund";
+
+// Maps the current status + event to the status that follows it. A missing
+// entry means the event does not move the invoice out of its current status
+// (e.g. sending an invoice that was already paid before it was sent still
+// leaves it "paid", it just records that it was also sent).
+const transitions: Record<InvoiceStatus, Partial<Record<InvoiceEvent, InvoiceStatus>>> = {
+  draft: { send: "sent", pay: "paid", void: "voided" },
+  sent: { send: "sent", pay: "paid", void: "voided" },
+  paid: { send: "paid", refund: "refunded" },
+  voided: {},
+  refunded: { send: "refunded" },
+};
+
+type TimestampField = "sentAt" | "paidAt" | "voidedAt" | "refundedAt";
+
+function applyEvent(
+  invoice: Invoice,
+  event: InvoiceEvent,
+  timestampField: TimestampField,
+  at: string,
+  guard: (invoice: Invoice) => boolean,
+  errorMessage: string,
+): Invoice {
+  if (!guard(invoice)) throw new Error(errorMessage);
+  if (invoice[timestampField] !== undefined) return invoice;
+  const nextStatus = transitions[invoice.status][event] ?? invoice.status;
+  return { ...invoice, status: nextStatus, [timestampField]: at };
+}

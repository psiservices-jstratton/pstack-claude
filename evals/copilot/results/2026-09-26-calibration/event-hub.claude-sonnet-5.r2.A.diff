+test("a once listener does not cause a later listener to be skipped", () => {
+  const hub = new EventHub<AppEvents>();
+  const calls: string[] = [];
+  hub.once("notice", (message) => calls.push(`once:${message}`));
+  hub.on("notice", (message) => calls.push(`normal:${message}`));
+
+  hub.emit("notice", "first");
+  hub.emit("notice", "second");
+
+  assert.deepEqual(calls, ["once:first", "normal:first", "normal:second"]);
+});

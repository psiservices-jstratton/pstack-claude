diff --git a/test/feed.test.ts b/test/feed.test.ts
index cd62b35..8c239cc 100644
--- a/test/feed.test.ts
+++ b/test/feed.test.ts
@@ -29,3 +29,27 @@ test("supports descending order", () => {
 test("can filter by status", () => {
   assert.deepEqual(collectAllOrders(orders, { limit: 1, status: "paid" }).map((order) => order.id), ["ord-1", "ord-3"]);
 });
+
+const flashSaleOrders: Order[] = [
+  { id: "ord-a", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 1000, status: "paid" },
+  { id: "ord-b", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 2000, status: "paid" },
+  { id: "ord-c", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 3000, status: "paid" },
+  { id: "ord-d", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 4000, status: "paid" },
+];
+
+test("does not skip or duplicate orders sharing a timestamp when a page splits the tie group (asc)", () => {
+  const all = collectAllOrders(flashSaleOrders, { limit: 2 });
+  assert.deepEqual(all.map((order) => order.id), ["ord-a", "ord-b", "ord-c", "ord-d"]);
+});
+
+test("does not skip or duplicate orders sharing a timestamp when a page splits the tie group (desc)", () => {
+  const all = collectAllOrders(flashSaleOrders, { limit: 2, direction: "desc" });
+  assert.deepEqual(all.map((order) => order.id), ["ord-d", "ord-c", "ord-b", "ord-a"]);
+});
+
+test("cursor resumes exactly after the last returned order, even mid-tie-group", () => {
+  const first = listOrders(flashSaleOrders, { limit: 1 });
+  assert.deepEqual(first.orders.map((order) => order.id), ["ord-a"]);
+  const second = listOrders(flashSaleOrders, { limit: 1, cursor: first.nextCursor });
+  assert.deepEqual(second.orders.map((order) => order.id), ["ord-b"]);
+});

diff --git a/src/rollup.ts b/src/rollup.ts
new file mode 100644
index 0000000..8a7b17c
--- /dev/null
+++ b/src/rollup.ts
@@ -0,0 +1,54 @@
+import type { Account, DateRange, UsageEvent } from "./types.ts";
+
+/** Buckets an ISO timestamp into a local calendar day using the account's UTC offset. */
+export function localDay(iso: string, offsetMinutes: number): string {
+  const shifted = new Date(new Date(iso).getTime() + offsetMinutes * 60_000);
+  return shifted.toISOString().slice(0, 10);
+}
+
+/** Buckets an ISO timestamp into a UTC calendar day. */
+export function utcDay(iso: string): string {
+  return new Date(iso).toISOString().slice(0, 10);
+}
+
+export type RollupOptions<T> = {
+  /** Derives the calendar day bucket key for an event. */
+  dayOf: (event: UsageEvent, account: Account) => string;
+  /** Optional additional predicate beyond the account/date-range match (e.g. billable-only). */
+  filter?: (event: UsageEvent) => boolean;
+  /** Whether the range end boundary is inclusive (`<= end`) or exclusive (`< end`). */
+  endInclusive: boolean;
+  /** Creates the initial bucket value for a newly seen day. */
+  createBucket: () => T;
+  /** Folds an event into a bucket, returning the (possibly mutated) updated bucket. */
+  addEvent: (bucket: T, event: UsageEvent) => T;
+};
+
+/**
+ * Shared date-filtering and daily rollup used by every usage export. Iterates events for the
+ * given account within the date range, grouping them into per-day buckets via the supplied
+ * options. Callers control the bucket shape and aggregation so output bytes/shapes are unchanged.
+ */
+export function rollupByDay<T>(
+  account: Account,
+  events: UsageEvent[],
+  range: DateRange,
+  options: RollupOptions<T>,
+): Map<string, T> {
+  const start = new Date(range.start).getTime();
+  const end = new Date(range.end).getTime();
+  const buckets = new Map<string, T>();
+
+  for (const event of events) {
+    if (event.accountId !== account.id) continue;
+    if (options.filter && !options.filter(event)) continue;
+    const at = new Date(event.occurredAt).getTime();
+    if (at < start) continue;
+    if (options.endInclusive ? at > end : at >= end) continue;
+    const day = options.dayOf(event, account);
+    const bucket = buckets.has(day) ? buckets.get(day)! : options.createBucket();
+    buckets.set(day, options.addEvent(bucket, event));
+  }
+
+  return buckets;
+}

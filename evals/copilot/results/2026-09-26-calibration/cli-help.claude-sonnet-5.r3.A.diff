+// Greedily wraps `text` into lines no wider than `maxWidth`. A single word
+// longer than `maxWidth` is kept intact on its own line rather than split.
+function wrapText(text: string, maxWidth: number): string[] {
+  if (maxWidth <= 0) {
+    return [text];
+  }
+  const words = text.split(" ").filter((word) => word.length > 0);
+  if (!words.length) {
+    return [text];
+  }
+
+  const lines: string[] = [];
+  let current = "";
+  for (const word of words) {
+    if (!current) {
+      current = word;
+      continue;
+    }
+    if (current.length + 1 + word.length <= maxWidth) {
+      current += ` ${word}`;
+    } else {
+      lines.push(current);
+      current = word;
+    }
+  }
+  if (current) {
+    lines.push(current);
+  }
+  return lines;
+}
+
+function pushEntry(lines: string[], label: string, labelWidth: number, description: string, width: number | undefined): void {
+  const prefixWidth = 2 + labelWidth + 2;
+  const prefix = `  ${padVisible(label, labelWidth)}  `;
+  if (!width) {
+    lines.push(`${prefix}${description}`);
+    return;
+  }
+
+  const descWidth = width - prefixWidth;
+  const descLines = wrapText(description, descWidth);
+  lines.push(`${prefix}${descLines[0] ?? ""}`);
+  const continuationIndent = " ".repeat(prefixWidth);
+  for (const line of descLines.slice(1)) {
+    lines.push(`${continuationIndent}${line}`);
+  }
+}

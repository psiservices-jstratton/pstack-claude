--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,56 @@
+import { isSchemaObject } from "./schema.ts";
+import type { LeafType, Settings, SettingsSchema } from "./schema.ts";
+
+export type EnvMap = Record<string, string | undefined>;
+
+const ENV_PREFIX = "APP_";
+
+function envKeyFor(path: string[]): string {
+  return ENV_PREFIX + path.map((segment) => segment.toUpperCase()).join("__");
+}
+
+function coerce(dotted: string, type: LeafType, raw: string): unknown {
+  switch (type) {
+    case "string":
+      return raw;
+    case "number": {
+      const value = Number(raw);
+      if (raw.trim() === "" || Number.isNaN(value)) {
+        throw new Error(`${dotted} could not be parsed as a number`);
+      }
+      return value;
+    }
+    case "boolean": {
+      const normalized = raw.trim().toLowerCase();
+      if (normalized === "true" || normalized === "1") return true;
+      if (normalized === "false" || normalized === "0") return false;
+      throw new Error(`${dotted} could not be parsed as a boolean`);
+    }
+  }
+}
+
+export function readEnvSettings(schema: SettingsSchema, env: EnvMap, path: string[] = []): Settings {
+  const lookup = new Map<string, string>();
+  for (const [key, value] of Object.entries(env)) {
+    if (value !== undefined) lookup.set(key.toUpperCase(), value);
+  }
+
+  const walk = (node: SettingsSchema, currentPath: string[]): Settings => {
+    const result: Settings = {};
+    for (const [key, child] of Object.entries(node)) {
+      const childPath = [...currentPath, key];
+      if (isSchemaObject(child)) {
+        const nested = walk(child, childPath);
+        if (Object.keys(nested).length > 0) result[key] = nested;
+        continue;
+      }
+      const envKey = envKeyFor(childPath);
+      const raw = lookup.get(envKey);
+      if (raw === undefined) continue;
+      result[key] = coerce(childPath.join("."), child, raw);
+    }
+    return result;
+  };
+
+  return walk(schema, path);
+}

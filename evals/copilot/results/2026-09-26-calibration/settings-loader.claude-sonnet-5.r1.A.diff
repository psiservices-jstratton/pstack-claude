diff --git a/test/loader.test.ts b/test/loader.test.ts
index f3c89b9..cc8e7e8 100644
--- a/test/loader.test.ts
+++ b/test/loader.test.ts
@@ -32,3 +32,36 @@ test("rejects settings outside the declared schema", () => {
     /service\.workers/,
   );
 });
+
+test("environment overrides beat the JSON file and are coerced to the schema type", () => {
+  const settings = loadSettings({
+    path: dataFile,
+    env: {
+      app_db__port: "6543",
+      APP_DB__SSL: "true",
+      APP_FEATURES__SIGNUP: "0",
+      APP_SERVICE__WORKERS: "4",
+    },
+  });
+  assert.equal(getSetting(settings, "db.port"), 6543);
+  assert.equal(getSetting(settings, "db.ssl"), true);
+  assert.equal(getSetting(settings, "features.signup"), false);
+  assert.equal(getSetting(settings, "service.host"), "0.0.0.0");
+});
+
+test("defaults to process.env when no env option is provided", () => {
+  process.env.APP_SERVICE__PORT = "6000";
+  try {
+    const settings = loadSettings();
+    assert.equal(getSetting(settings, "service.port"), 6000);
+  } finally {
+    delete process.env.APP_SERVICE__PORT;
+  }
+});
+
+test("throws with the dotted setting name when a number cannot be parsed", () => {
+  assert.throws(
+    () => loadSettings({ env: { APP_SERVICE__PORT: "not-a-number" } }),
+    /service\.port/,
+  );
+});

@@ -32,3 +32,28 @@ test("rejects settings outside the declared schema", () => {
     /service\.workers/,
   );
 });
+
+test("environment overrides win over the JSON file, matched case-insensitively", () => {
+  const settings = loadSettings({
+    path: dataFile,
+    env: {
+      app_service__port: "9999",
+      APP_DB__HOST: "db.internal",
+      APP_FEATURES__SIGNUP: "false",
+    },
+  });
+  assert.equal(getSetting(settings, "service.port"), 9999);
+  assert.equal(getSetting(settings, "db.host"), "db.internal");
+  assert.equal(getSetting(settings, "features.signup"), false);
+  // Untouched values still come from the file/defaults.
+  assert.equal(getSetting(settings, "service.host"), "0.0.0.0");
+});
+
+test("ignores env vars for settings not declared in the schema", () => {
+  const settings = loadSettings({ env: { APP_SERVICE__WORKERS: "4" } });
+  assert.equal((getSetting(settings, "service") as Record<string, unknown>).workers, undefined);
+});
+
+test("throws with the dotted setting name when a number can't be parsed", () => {
+  assert.throws(() => loadSettings({ env: { APP_DB__PORT: "not-a-number" } }), /db\.port/);
+});

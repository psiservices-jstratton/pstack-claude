index 0000000..0b1d675
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,52 @@
+import { isSchemaObject } from "./schema.ts";
+import type { LeafType, Settings, SettingsSchema } from "./schema.ts";
+
+export type EnvMap = Record<string, string | undefined>;
+
+const ENV_PREFIX = "APP_";
+
+function coerce(raw: string, type: LeafType, dotted: string): unknown {
+  switch (type) {
+    case "string":
+      return raw;
+    case "boolean":
+      return raw.toLowerCase() === "true" || raw === "1";
+    case "number": {
+      const value = Number(raw);
+      if (Number.isNaN(value)) throw new Error(`${dotted} must be a number`);
+      return value;
+    }
+  }
+}
+
+/**
+ * Builds a Settings object from environment variables, following the schema.
+ * Variable names use the APP_ prefix, double underscores for nesting
+ * (e.g. APP_DB__PORT for db.port), and are matched case-insensitively.
+ */
+export function loadEnvSettings(env: EnvMap, schema: SettingsSchema): Settings {
+  const upperEnv = new Map<string, string>();
+  for (const [key, value] of Object.entries(env)) {
+    if (value === undefined) continue;
+    upperEnv.set(key.toUpperCase(), value);
+  }
+
+  function walk(node: SettingsSchema, path: string[]): Settings {
+    const result: Settings = {};
+    for (const [key, child] of Object.entries(node)) {
+      const nextPath = [...path, key];
+      if (isSchemaObject(child)) {
+        const nested = walk(child, nextPath);
+        if (Object.keys(nested).length > 0) result[key] = nested;
+        continue;
+      }
+      const varName = `${ENV_PREFIX}${nextPath.map((segment) => segment.toUpperCase()).join("__")}`;
+      const raw = upperEnv.get(varName);
+      if (raw === undefined) continue;
+      result[key] = coerce(raw, child, nextPath.join("."));
+    }
+    return result;
+  }
+
+  return walk(schema, []);
+}

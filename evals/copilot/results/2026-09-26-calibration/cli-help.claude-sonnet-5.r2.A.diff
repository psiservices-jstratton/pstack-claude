+// Greedily wraps `text` into lines no wider than `maxWidth` visible columns.
+// A single word longer than `maxWidth` is placed alone on its own line rather
+// than being split. When `maxWidth` is undefined (no width constraint), the
+// text is returned as a single line unchanged.
+function wrapText(text: string, maxWidth: number | undefined): string[] {
+  if (maxWidth === undefined || maxWidth < 1 || visibleLength(text) <= maxWidth) {
+    return [text];
+  }
+
+  const words = text.split(" ");
+  const lines: string[] = [];
+  let current = "";
+
+  for (const word of words) {
+    if (current === "") {
+      current = word;
+      continue;
+    }
+    const candidate = `${current} ${word}`;
+    if (visibleLength(candidate) <= maxWidth) {
+      current = candidate;
+    } else {
+      lines.push(current);
+      current = word;
+    }
+  }
+  if (current !== "") {
+    lines.push(current);
+  }
+  return lines;
+}
+
+// Renders one entry (a command or a flag) as one or more lines, wrapping the
+// description to fit within `width` and aligning continuation lines under the
+// description column (which starts after the indent + padded label + gap).
+function renderEntry(label: string, labelWidth: number, description: string, width: number | undefined): string[] {
+  const indent = "  ";
+  const gap = "  ";
+  const continuationPrefix = " ".repeat(indent.length + labelWidth + gap.length);
+  const maxWidth = width === undefined ? undefined : width - continuationPrefix.length;
+  const descriptionLines = wrapText(description, maxWidth);
+
+  return descriptionLines.map((line, index) =>
+    index === 0 ? `${indent}${padVisible(label, labelWidth)}${gap}${line}` : `${continuationPrefix}${line}`,
+  );
+}

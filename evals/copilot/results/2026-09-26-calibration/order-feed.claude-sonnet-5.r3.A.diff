+test("does not skip or repeat orders sharing a timestamp across a page boundary", () => {
+  const flashSale: Order[] = [
+    { id: "ord-a", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 100, status: "paid" },
+    { id: "ord-b", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 200, status: "paid" },
+    { id: "ord-c", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 300, status: "paid" },
+    { id: "ord-d", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 400, status: "paid" },
+  ];
+  assert.deepEqual(
+    collectAllOrders(flashSale, { limit: 2 }).map((order) => order.id),
+    ["ord-a", "ord-b", "ord-c", "ord-d"],
+  );
+});
+
+test("tie-break also respects descending direction", () => {
+  const flashSale: Order[] = [
+    { id: "ord-a", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 100, status: "paid" },
+    { id: "ord-b", createdAt: "2026-04-01T10:00:00.000Z", totalCents: 200, status: "paid" },

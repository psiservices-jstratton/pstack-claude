diff --git a/src/registry.ts b/src/registry.ts
index bc10d7e..00a65c2 100644
--- a/src/registry.ts
+++ b/src/registry.ts
@@ -1,3 +1,30 @@
+import { slugify, truncateSlug, type SlugOptions } from "./slug.ts";
+
 export function articlePath(slug: string): string {
   return `/articles/${slug}`;
 }
+
+/**
+ * Builds a slug for `title` using the same rules as `slugify`, then
+ * disambiguates it against `existing` slugs by appending `-2`, `-3`, etc.,
+ * truncating the base slug as needed so the final result stays within
+ * `maxLength`.
+ */
+export function uniqueSlug(
+  title: string,
+  existing: Iterable<string>,
+  options: SlugOptions = {},
+): string {
+  const maxLength = options.maxLength ?? 60;
+  const taken = new Set(existing);
+  const base = slugify(title, options);
+  if (!taken.has(base)) return base;
+
+  for (let n = 2; ; n++) {
+    const suffix = `-${n}`;
+    const room = maxLength - suffix.length;
+    const trimmedBase = base.length > room ? truncateSlug(base, room) : base;
+    const candidate = `${trimmedBase}${suffix}`;
+    if (!taken.has(candidate)) return candidate;
+  }
+}

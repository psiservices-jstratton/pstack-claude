 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { articlePath, createArticle, slugify } from "../src/index.ts";
+import { articlePath, createArticle, slugify, uniqueSlug } from "../src/index.ts";
 
 test("normalizes punctuation and accents", () => {
   assert.equal(slugify("Crème brûlée & Café"), "creme-brulee-cafe");
@@ -20,3 +20,24 @@ test("creates article records with paths", () => {
   assert.equal(article.slug, "roadmap-q4-launch");
   assert.equal(articlePath(article.slug), "/articles/roadmap-q4-launch");
 });
+
+test("returns the plain slug when there is no collision", () => {
+  assert.equal(uniqueSlug("Café", []), "cafe");
+});
+
+test("appends an incrementing suffix on collisions", () => {
+  assert.equal(uniqueSlug("Café", ["cafe"]), "cafe-2");
+  assert.equal(uniqueSlug("Café", ["cafe", "cafe-2"]), "cafe-3");
+});
+
+test("uses the fallback slug and disambiguates it too", () => {
+  assert.equal(uniqueSlug("***", []), "article");
+  assert.equal(uniqueSlug("***", ["article"]), "article-2");
+});
+
+test("keeps the disambiguated slug within maxLength", () => {
+  const longBase = "a".repeat(60);
+  const slug = uniqueSlug(longBase, [longBase]);
+  assert.equal(slug, `${"a".repeat(58)}-2`);
+  assert.ok(slug.length <= 60);
+});

@@ -0,0 +1,34 @@
+import type { DocumentRecord, User } from "./types.ts";
+
+/**
+ * Result of an access check against a document:
+ * - "allow": the action may proceed.
+ * - "forbidden": the user is known to lack permission (403).
+ * - "not_found": the user should not learn the document exists (404).
+ */
+export type AccessDecision = "allow" | "forbidden" | "not_found";
+
+function isTeamMember(user: User, doc: DocumentRecord): boolean {
+  return user.teamIds.includes(doc.teamId);
+}
+
+export function checkReadAccess(user: User, doc: DocumentRecord): AccessDecision {
+  if (user.role === "admin") return "allow";
+  if (doc.ownerId === user.id) return "allow";
+  if (isTeamMember(user, doc) && (!doc.confidential || user.role === "editor")) return "allow";
+  return "not_found";
+}
+
+export function checkAuditAccess(user: User, doc: DocumentRecord): AccessDecision {
+  if (!isTeamMember(user, doc)) return "not_found";
+  if (user.role !== "auditor") return "forbidden";
+  return "allow";
+}
+
+export function checkUpdateAccess(user: User, doc: DocumentRecord): AccessDecision {
+  if (user.role === "admin") return "allow";
+  if (doc.ownerId === user.id) return "allow";
+  if (!isTeamMember(user, doc)) return "not_found";
+  if (user.role !== "editor") return "forbidden";
+  return "allow";
+}

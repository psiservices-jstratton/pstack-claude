diff --git a/src/rollup.ts b/src/rollup.ts
new file mode 100644
index 0000000..a46edd2
--- /dev/null
+++ b/src/rollup.ts
@@ -0,0 +1,55 @@
+import type { Account, DateRange, UsageEvent } from "./types.ts";
+
+/** Day key derived from the account's local timezone offset. */
+export function localDay(iso: string, offsetMinutes: number): string {
+  const shifted = new Date(new Date(iso).getTime() + offsetMinutes * 60_000);
+  return shifted.toISOString().slice(0, 10);
+}
+
+/** Day key derived from UTC, ignoring the account's timezone offset. */
+export function utcDay(iso: string): string {
+  return new Date(iso).toISOString().slice(0, 10);
+}
+
+export type RollupOptions = {
+  /** Whether events occurring exactly at range.end are included. */
+  endInclusive: boolean;
+  /** Derives the bucket key for an event. */
+  dayKey: (event: UsageEvent) => string;
+  /** Optional extra predicate (e.g. billable-only) applied after the account match. */
+  filter?: (event: UsageEvent) => boolean;
+};
+
+/**
+ * Shared date-filtering and daily grouping logic for usage exports.
+ * Filters events to the given account and date range, then groups the
+ * remaining events by day key, preserving each event's original order
+ * within its bucket. Callers own the final aggregation/shape.
+ */
+export function groupEventsByDay(
+  account: Account,
+  events: UsageEvent[],
+  range: DateRange,
+  options: RollupOptions,
+): Map<string, UsageEvent[]> {
+  const start = new Date(range.start).getTime();
+  const end = new Date(range.end).getTime();
+  const buckets = new Map<string, UsageEvent[]>();
+
+  for (const event of events) {
+    if (event.accountId !== account.id) continue;
+    if (options.filter && !options.filter(event)) continue;
+    const at = new Date(event.occurredAt).getTime();
+    if (at < start) continue;
+    if (options.endInclusive ? at > end : at >= end) continue;
+    const day = options.dayKey(event);
+    const bucket = buckets.get(day);
+    if (bucket) {
+      bucket.push(event);
+    } else {
+      buckets.set(day, [event]);
+    }
+  }
+
+  return buckets;
+}

index ef5c317..d7ad516 100644
--- a/README.md
+++ b/README.md
@@ -2,4 +2,8 @@
 
 Loads service settings from defaults plus one JSON file. The schema declares every setting and its expected type, including nested sections.
 
+Settings can also be overridden with environment variables, which take precedence over both defaults and the JSON file. Variables must use the `APP_` prefix, with double underscores (`__`) separating nested keys, e.g. `APP_DB__PORT=5433` overrides `db.port`. Variable names are matched case-insensitively, and values are coerced to the declared schema type (numbers/booleans throw a descriptive error, naming the dotted setting, if they can't be parsed). Variables for settings not declared in the schema are ignored.
+
+By default `loadSettings()` reads from `process.env`; pass a `env` option with a process-like map (e.g. `{ APP_DB__PORT: "5433" }`) to override this, which is useful for testing or container launches.
+
 Run with `npm test` on Node 24.
diff --git a/src/env.ts b/src/env.ts
new file mode 100644
index 0000000..2b9bc62
--- /dev/null
+++ b/src/env.ts
@@ -0,0 +1,57 @@
+import { isSchemaObject } from "./schema.ts";
+import type { LeafType, Settings, SettingsSchema } from "./schema.ts";
+
+export type EnvMap = Record<string, string | undefined>;
+
+const PREFIX = "APP_";
+
+function coerce(dotted: string, type: LeafType, raw: string): unknown {
+  switch (type) {
+    case "string":
+      return raw;
+    case "number": {
+      const value = Number(raw);
+      if (Number.isNaN(value)) throw new Error(`${dotted} could not be parsed as a number from environment value "${raw}"`);
+      return value;
+    }
+    case "boolean": {
+      const normalized = raw.trim().toLowerCase();
+      if (normalized === "true" || normalized === "1") return true;
+      if (normalized === "false" || normalized === "0") return false;
+      throw new Error(`${dotted} could not be parsed as a boolean from environment value "${raw}"`);
+    }
+    default:
+      return raw;
+  }
+}
+
+export function readEnvSettings(env: EnvMap, schema: SettingsSchema): Settings {
+  const normalized = new Map<string, string>();
+  for (const [key, value] of Object.entries(env)) {
+    if (value === undefined) continue;
+    normalized.set(key.toUpperCase(), value);
+  }
+
+  function walk(node: SettingsSchema, path: string[]): Settings | undefined {
+    let result: Settings | undefined;
+    for (const [key, child] of Object.entries(node)) {
+      const nextPath = [...path, key];
+      if (isSchemaObject(child)) {
+        const nested = walk(child, nextPath);
+        if (nested !== undefined) {
+          result ??= {};
+          result[key] = nested;
+        }
+        continue;
+      }
+      const varName = PREFIX + nextPath.map((segment) => segment.toUpperCase()).join("__");
+      const raw = normalized.get(varName);
+      if (raw === undefined) continue;
+      result ??= {};
+      result[key] = coerce(nextPath.join("."), child, raw);
+    }
+    return result;
+  }
+
+  return walk(schema, []) ?? {};
+}

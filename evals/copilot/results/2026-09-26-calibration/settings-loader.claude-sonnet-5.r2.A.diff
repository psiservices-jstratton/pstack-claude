diff --git a/test/loader.test.ts b/test/loader.test.ts
index f3c89b9..032bd83 100644
--- a/test/loader.test.ts
+++ b/test/loader.test.ts
@@ -32,3 +32,23 @@ test("rejects settings outside the declared schema", () => {
     /service\.workers/,
   );
 });
+
+test("env overrides beat both defaults and the JSON file", () => {
+  const settings = loadSettings({
+    path: dataFile,
+    env: { APP_DB__PORT: "5433", app_db__host: "db.internal", APP_FEATURES__SIGNUP: "true" },
+  });
+  assert.equal(getSetting(settings, "db.port"), 5433);
+  assert.equal(getSetting(settings, "db.host"), "db.internal");
+  assert.equal(getSetting(settings, "features.signup"), true);
+  assert.equal(getSetting(settings, "service.port"), 9000);
+});
+
+test("ignores env variables for settings outside the schema", () => {
+  const settings = loadSettings({ env: { APP_SERVICE__WORKERS: "4" } });
+  assert.equal(getSetting(settings, "service.port"), 8080);
+});
+
+test("throws a descriptive error when a number env var can't be parsed", () => {
+  assert.throws(() => loadSettings({ env: { APP_SERVICE__PORT: "fast" } }), /service\.port/);
+});

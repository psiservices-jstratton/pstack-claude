+import { slugify, truncateSlug, type SlugOptions } from "./slug.ts";
+
 export function articlePath(slug: string): string {
   return `/articles/${slug}`;
 }
+
+/**
+ * Builds a slug for `title` that does not collide with any slug in `existing`.
+ * Collisions are resolved by appending "-2", "-3", etc., truncating the base
+ * slug as needed so the final result still respects `maxLength`.
+ */
+export function uniqueSlug(
+  title: string,
+  existing: Iterable<string>,
+  options: SlugOptions = {},
+): string {
+  const maxLength = options.maxLength ?? 60;
+  const base = slugify(title, options);
+  const seen = existing instanceof Set ? existing : new Set(existing);
+
+  if (!seen.has(base)) return base;
+
+  for (let counter = 2; ; counter++) {
+    const suffix = `-${counter}`;
+    const room = maxLength - suffix.length;
+    const trimmed = base.length > room ? truncateSlug(base, room) : base;
+    const candidate = `${trimmed}${suffix}`;
+    if (!seen.has(candidate)) return candidate;
+  }
+}

+export type InvoiceStatus = "draft" | "sent" | "paid" | "voided" | "refunded";
+
 export type Invoice = {
   id: string;
   customerId: string;
   cents: number;
-  sent: boolean;
-  paid: boolean;
-  voided: boolean;
-  refunded: boolean;
+  status: InvoiceStatus;
   sentAt?: string;
   paidAt?: string;
   voidedAt?: string;
   refundedAt?: string;
 };
 
+type Transition = {
+  /** Timestamp field this action records; its presence also makes the action idempotent. */
+  timestampField: "sentAt" | "paidAt" | "voidedAt" | "refundedAt";
+  /** Returns an error message if the invoice's current state forbids this action, otherwise undefined. */
+  guard: (invoice: Invoice) => string | undefined;
+  /** Determines the resulting status once the action is applied. */
+  nextStatus: (current: InvoiceStatus) => InvoiceStatus;
+};
+
+const TRANSITIONS: Record<"send" | "pay" | "void" | "refund", Transition> = {
+  send: {
+    timestampField: "sentAt",
+    guard: (invoice) => (invoice.status === "voided" ? "cannot send voided invoice" : undefined),
+    // Paid/refunded invoices outrank "sent" in the reported status, so sending one of those keeps its status.
+    nextStatus: (current) => (current === "draft" ? "sent" : current),
+  },
+  pay: {
+    timestampField: "paidAt",
+    guard: (invoice) => (invoice.status === "voided" ? "cannot pay voided invoice" : undefined),
+    nextStatus: () => "paid",
+  },
+  void: {
+    timestampField: "voidedAt",
+    guard: (invoice) => (invoice.paidAt ? "cannot void paid invoice" : undefined),
+    nextStatus: () => "voided",
+  },
+  refund: {
+    timestampField: "refundedAt",
+    guard: (invoice) => (invoice.paidAt ? undefined : "cannot refund unpaid invoice"),
+    nextStatus: () => "refunded",
+  },
+};
+
+function applyTransition(action: keyof typeof TRANSITIONS, invoice: Invoice, at: string): Invoice {
+  const transition = TRANSITIONS[action];
+  const error = transition.guard(invoice);
+  if (error) throw new Error(error);
+  if (invoice[transition.timestampField]) return invoice;
+  return {
+    ...invoice,
+    status: transition.nextStatus(invoice.status),
+    [transition.timestampField]: at,
+  };
+}
+

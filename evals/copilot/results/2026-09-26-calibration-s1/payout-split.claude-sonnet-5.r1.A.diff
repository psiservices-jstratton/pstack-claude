+  // Use floor-division on the exact (integer) numerator/denominator pair so the
+  // shares always sum back to amountCents, even for negative amounts (refunds).
+  // Any cents lost to rounding are handed out, one at a time, to the recipients
+  // with the largest fractional remainder, ties broken by original order.
+  const bases: number[] = [];
+  const remainders: number[] = [];
+  let baseSum = 0;
+  for (const recipient of recipients) {
+    const numerator = amountCents * recipient.weight;
+    const base = Math.floor(numerator / weight);
+    bases.push(base);
+    remainders.push(numerator - base * weight);
+    baseSum += base;
+  }
+
+  let leftover = amountCents - baseSum;
+  const order = recipients.map((_, index) => index);
+  order.sort((a, b) => remainders[b] - remainders[a] || a - b);
+
+  const cents = [...bases];
+  for (const index of order) {
+    if (leftover <= 0) break;
+    cents[index] += 1;
+    leftover -= 1;
+  }
+
+  return recipients.map((recipient, index) => ({ recipientId: recipient.id, cents: cents[index] }));

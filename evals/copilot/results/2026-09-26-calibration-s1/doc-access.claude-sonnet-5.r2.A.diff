+++ b/src/policy.ts
@@ -0,0 +1,40 @@
+import { forbidden, notFound } from "./responses.ts";
+import type { DocumentRecord, Response, Store, User } from "./types.ts";
+
+/**
+ * Central access-control policy for documents. Each handler resolves the
+ * document via `resolveDocument` and then asks the relevant `authorize*`
+ * function whether the requesting user may proceed. A `null` return means
+ * "allowed"; otherwise the returned Response must be sent as-is, including
+ * not-found responses used to mask a document's existence from users who
+ * should not know about it.
+ */
+
+export function resolveDocument(id: string, store: Store): DocumentRecord | Response {
+  const doc = store.documents.get(id);
+  return doc ?? notFound();
+}
+
+export function authorizeRead(user: User, doc: DocumentRecord): Response | null {
+  if (user.role === "admin") return null;
+  if (doc.ownerId === user.id) return null;
+  if (user.teamIds.includes(doc.teamId) && (!doc.confidential || user.role === "editor")) return null;
+
+  return notFound();
+}
+
+export function authorizeUpdate(user: User, doc: DocumentRecord): Response | null {
+  if (user.role === "admin") return null;
+  if (doc.ownerId === user.id) return null;
+  if (!user.teamIds.includes(doc.teamId)) return notFound();
+  if (user.role !== "editor") return forbidden();
+
+  return null;
+}
+
+export function authorizeAuditRead(user: User, doc: DocumentRecord): Response | null {
+  if (!user.teamIds.includes(doc.teamId)) return notFound();
+  if (user.role !== "auditor") return forbidden();
+
+  return null;
+}

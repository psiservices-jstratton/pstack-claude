+function buildOutgoing(roads: readonly Road[]): Map<string, Road[]> {
+  const outgoing = new Map<string, Road[]>();
+  for (const road of roads) {
+    if (road.cost < 0) throw new RangeError("Road costs must be non-negative");
+    const list = outgoing.get(road.from);
+    if (list) list.push(road);
+    else outgoing.set(road.from, [road]);
+  }
+  for (const list of outgoing.values()) list.sort((a, b) => a.to.localeCompare(b.to));
+  return outgoing;
+}

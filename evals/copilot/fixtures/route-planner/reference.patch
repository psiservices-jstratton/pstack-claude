+function compareEntry(a: QueueEntry, b: QueueEntry): number {
+  if (a.cost !== b.cost) return a.cost - b.cost;
+  if (a.hops !== b.hops) return a.hops - b.hops;
+  return a.key.localeCompare(b.key);
+}
+
+class RouteQueue {
+  #items: QueueEntry[] = [];
+
+  get size(): number {
+    return this.#items.length;
+  }
+
+  push(entry: QueueEntry): void {
+    this.#items.push(entry);
+    this.#bubbleUp(this.#items.length - 1);
+  }
+
+  pop(): QueueEntry | undefined {
+    const first = this.#items[0];
+    const last = this.#items.pop();
+    if (last && this.#items.length > 0) {
+      this.#items[0] = last;
+      this.#bubbleDown(0);
+    }
+    return first;
+  }
+
+  #bubbleUp(index: number): void {
+    while (index > 0) {
+      const parent = Math.floor((index - 1) / 2);
+      if (compareEntry(this.#items[parent], this.#items[index]) <= 0) break;
+      [this.#items[parent], this.#items[index]] = [this.#items[index], this.#items[parent]];
+      index = parent;
+    }
+  }
+
+  #bubbleDown(index: number): void {
+    while (true) {
+      const left = index * 2 + 1;
+      const right = left + 1;
+      let smallest = index;
+      if (left < this.#items.length && compareEntry(this.#items[left], this.#items[smallest]) < 0) smallest = left;
+      if (right < this.#items.length && compareEntry(this.#items[right], this.#items[smallest]) < 0) smallest = right;
+      if (smallest === index) break;
+      [this.#items[index], this.#items[smallest]] = [this.#items[smallest], this.#items[index]];
+      index = smallest;
+    }
+  }
+}

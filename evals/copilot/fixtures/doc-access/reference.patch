@@ -0,0 +1,24 @@
+import type { DocumentRecord, User } from "./types.ts";
+
+export type Access = "allow" | "not-found" | "forbidden";
+
+export function readAccess(user: User, doc: DocumentRecord): Access {
+  if (user.role === "admin") return "allow";
+  if (doc.ownerId === user.id) return "allow";
+  if (user.teamIds.includes(doc.teamId) && (!doc.confidential || user.role === "editor")) return "allow";
+  return "not-found";
+}
+
+export function updateAccess(user: User, doc: DocumentRecord): Access {
+  if (user.role === "admin") return "allow";
+  if (doc.ownerId === user.id) return "allow";
+  if (!user.teamIds.includes(doc.teamId)) return "not-found";
+  if (user.role !== "editor") return "forbidden";
+  return "allow";
+}
+
+export function auditAccess(user: User, doc: DocumentRecord): Access {
+  if (!user.teamIds.includes(doc.teamId)) return "not-found";
+  if (user.role !== "auditor") return "forbidden";
+  return "allow";
+}

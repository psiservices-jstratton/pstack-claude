+import { mergeSettings } from "./merge.ts";
+import { isSchemaObject } from "./schema.ts";
+import type { LeafType, Settings, SettingsSchema } from "./schema.ts";
+
+type SchemaEntry = { path: string[]; type: LeafType };
+
+function schemaEntries(schema: SettingsSchema, path: string[] = []): SchemaEntry[] {
+  return Object.entries(schema).flatMap(([key, node]) => {
+    const nextPath = [...path, key];
+    return isSchemaObject(node) ? schemaEntries(node, nextPath) : [{ path: nextPath, type: node }];
+  });
+}
+
+function coerceValue(value: string, type: LeafType, dotted: string): string | number | boolean {
+  if (type === "string") return value;
+  if (type === "number") {
+    const number = Number(value);
+    if (value.trim() === "" || !Number.isFinite(number)) throw new Error(`${dotted} must be a number`);
+    return number;
+  }
+
+  const normalized = value.trim().toLowerCase();
+  if (["true", "1", "yes", "on"].includes(normalized)) return true;
+  if (["false", "0", "no", "off"].includes(normalized)) return false;
+  throw new Error(`${dotted} must be a boolean`);
+}
+
+function setPath(settings: Settings, path: string[], value: string | number | boolean): void {
+  let target = settings;
+  for (const key of path.slice(0, -1)) {
+    const next = target[key];
+    if (typeof next !== "object" || next === null || Array.isArray(next)) target[key] = {};
+    target = target[key] as Settings;
+  }
+  target[path[path.length - 1]] = value;
+}
+
+export function applyEnvOverrides(
+  settings: Settings,
+  schema: SettingsSchema,
+  env: Record<string, string | undefined>,
+  prefix = "APP_",
+): Settings {
+  const result = mergeSettings({}, settings);
+  const prefixUpper = prefix.toUpperCase();
+  const byName = new Map(
+    schemaEntries(schema).map((entry) => [`${prefixUpper}${entry.path.map((part) => part.toUpperCase()).join("__")}`, entry]),
+  );
+
+  for (const [rawName, rawValue] of Object.entries(env)) {
+    if (rawValue === undefined) continue;
+    const entry = byName.get(rawName.toUpperCase());
+    if (!entry) continue;
+    const dotted = entry.path.join(".");
+    setPath(result, entry.path, coerceValue(rawValue, entry.type, dotted));
+  }
+  return result;
+}

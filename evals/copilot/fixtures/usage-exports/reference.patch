diff --git a/src/rollup.ts b/src/rollup.ts
new file mode 100644
index 0000000..b1a089f
--- /dev/null
+++ b/src/rollup.ts
@@ -0,0 +1,42 @@
+import type { Account, DateRange, UsageEvent } from "./types.ts";
+
+export type DailyBucket = {
+  day: string;
+  totalUnits: number;
+  eventIds: string[];
+  productUnits: Map<string, number>;
+};
+
+export type RollupOptions = {
+  end: "inclusive" | "exclusive";
+  day: "account" | "utc";
+  billableOnly?: boolean;
+};
+
+function dayKey(event: UsageEvent, account: Account, mode: RollupOptions["day"]): string {
+  const instant = new Date(event.occurredAt).getTime();
+  const shifted = mode === "account" ? instant + account.timezoneOffsetMinutes * 60_000 : instant;
+  return new Date(shifted).toISOString().slice(0, 10);
+}
+
+export function rollupDailyUsage(account: Account, events: UsageEvent[], range: DateRange, options: RollupOptions): DailyBucket[] {
+  const start = new Date(range.start).getTime();
+  const end = new Date(range.end).getTime();
+  const buckets = new Map<string, DailyBucket>();
+
+  for (const event of events) {
+    if (event.accountId !== account.id) continue;
+    if (options.billableOnly && !event.billable) continue;
+    const at = new Date(event.occurredAt).getTime();
+    if (at < start) continue;
+    if (options.end === "inclusive" ? at > end : at >= end) continue;
+    const day = dayKey(event, account, options.day);
+    const bucket = buckets.get(day) ?? { day, totalUnits: 0, eventIds: [], productUnits: new Map<string, number>() };
+    bucket.totalUnits += event.units;
+    bucket.eventIds.push(event.id);
+    bucket.productUnits.set(event.product, (bucket.productUnits.get(event.product) ?? 0) + event.units);
+    buckets.set(day, bucket);
+  }
+
+  return [...buckets.values()].sort((a, b) => a.day.localeCompare(b.day));
+}

@@ -1,3 +1,20 @@
+import { slugify, truncateSlug } from "./slug.ts";
+import type { SlugOptions } from "./slug.ts";
+
 export function articlePath(slug: string): string {
   return `/articles/${slug}`;
 }
+
+export function uniqueSlug(title: string, existing: Iterable<string>, options: SlugOptions = {}): string {
+  const maxLength = options.maxLength ?? 60;
+  const taken = new Set(Array.from(existing, (slug) => slug.toLowerCase()));
+  const base = slugify(title, options);
+  if (!taken.has(base)) return base;
+
+  for (let index = 2; ; index++) {
+    const suffix = `-${index}`;
+    const stem = truncateSlug(base, maxLength - suffix.length);
+    const candidate = `${stem}${suffix}`;
+    if (!taken.has(candidate)) return candidate;
+  }
+}
